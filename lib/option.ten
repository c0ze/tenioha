型 選択<T> {
    無し。
    有り (値: T) を
}

関数 取り出す<T> (選択値: 選択<T>) から (既定値: T) を -> T {
    場合 選択値 {
        (無し) なら { 既定値 }
        (値 を 有り) なら { 値 }
    }
}

関数 写す<T, U> (選択値: 選択<T>) を (変換: 関数[T を -> U]) で -> 選択<U> {
    場合 選択値 {
        (無し) なら { (無し<U>) }
        (値 を 有り) なら { ((値 を 適用 変換) を 有り<U>) }
    }
}

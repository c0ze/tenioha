; Generic lists. Constructors and functions are exported through the import alias.
型 一覧<T> {
    空。
    節 (頭: T) を (尾: 一覧<T>) に
}

関数 長さ<T> (値: 一覧<T>) を -> 整数 {
    場合 値 {
        (空) なら { 0 }
        (_ を 残り に 節) なら { ((残り を 長さ<T>) に 1 を 足す) }
    }
}

関数 写す<T, U> (値: 一覧<T>) を (変換: 関数[T を -> U]) で -> 一覧<U> {
    場合 値 {
        (空) なら { (空<U>) }
        (先頭 を 残り に 節) なら {
            ((先頭 を 適用 変換) を (残り を 変換 で 写す<T, U>) に 節<U>)
        }
    }
}

関数 畳む<T, U> (値: 一覧<T>) を (初期: U) から (結合: 関数[U に, T を -> U]) で -> U {
    場合 値 {
        (空) なら { 初期 }
        (先頭 を 残り に 節) なら {
            次 は (初期 に 先頭 を 適用 結合)。
            (残り を 次 から 結合 で 畳む<T, U>)
        }
    }
}
